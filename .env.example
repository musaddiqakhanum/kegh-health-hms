# ABDM (Ayushman Bharat Digital Mission) — live ABHA verification.
# Get credentials by registering your HMS at https://abdm.gov.in (integrator signup).
# Without these the app runs ABHA verification in clearly-labelled demo mode.
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=
# "sandbox" (default) or "production"
ABDM_ENVIRONMENT=sandbox
# Optional overrides — defaults are chosen from ABDM_ENVIRONMENT.
# ABDM_GATEWAY_BASE=https://dev.abdm.gov.in
# ABDM_ABHA_BASE=https://abhasbx.abdm.gov.in
